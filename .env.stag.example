# Cấu hình tùy chọn cho Staging Auto-Bid Seeder & Staging API QA Runner
# Copy file này thành `.env.stag` (chmod 600 .env.stag) nếu bạn muốn ghi đè tài khoản QA mặc định.
# TUYỆT ĐỐI KHÔNG commit file `.env.stag` chứa mật khẩu thật lên Git.

GNS_STAG_API_BASE_URL=https://services.stag.goodnstay.com
GNS_STAG_WEB_ORIGIN=https://web.stag.goodnstay.com
GNS_STAG_EMAIL=your-qa-account@example.com
GNS_STAG_PASSWORD=PASTE_YOUR_STAGING_QA_PASSWORD_HERE
GNS_STAG_LOCALE=en-US
